---
import { SITE_CONFIG } from '../data/config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_CONFIG.url}/#localbusiness`,
  name: SITE_CONFIG.nap.name,
  description: SITE_CONFIG.description,
  url: SITE_CONFIG.url,
  telephone: SITE_CONFIG.nap.telephone,
  email: SITE_CONFIG.nap.email,
  image: `${SITE_CONFIG.url}/og-image.jpg`,
  logo: `${SITE_CONFIG.url}/favicon.svg`,
  priceRange: '$$',
  openingHoursSpecification: SITE_CONFIG.openingHours.map((oh) => {
    const [days, hours] = oh.split(' ');
    return {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: days.split('-').map((d) => {
        const map: Record<string, string> = {
          Mo: 'Monday',
          Tu: 'Tuesday',
          We: 'Wednesday',
          Th: 'Thursday',
          Fr: 'Friday',
          Sa: 'Saturday',
          Su: 'Sunday',
        };
        return map[d];
      }),
      opens: hours.split('-')[0],
      closes: hours.split('-')[1],
    };
  }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${SITE_CONFIG.nap.address.number} ${SITE_CONFIG.nap.address.street}`,
    addressLocality: SITE_CONFIG.nap.address.city,
    addressRegion: SITE_CONFIG.nap.address.state,
    postalCode: SITE_CONFIG.nap.address.postalCode,
    addressCountry: SITE_CONFIG.nap.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE_CONFIG.geo.latitude,
    longitude: SITE_CONFIG.geo.longitude,
  },
  areaServed: SITE_CONFIG.areaServed.map((area) => ({
    '@type': 'City',
    name: area.city,
    address: {
      '@type': 'PostalAddress',
      addressRegion: area.state,
      addressCountry: 'BR',
    },
  })),
  sameAs: [SITE_CONFIG.social.whatsapp],
  foundingDate: SITE_CONFIG.foundingDate,
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
