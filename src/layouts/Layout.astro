---
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE_CONFIG } from '../data/config';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, ogImage, ogType, canonical, noindex } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <SEO
    title={title}
    description={description}
    ogImage={ogImage}
    ogType={ogType}
    canonical={canonical}
    noindex={noindex}
  />
  <SchemaLocalBusiness />
  <slot name="head" />
</head>
<body class="font-sans text-text-main antialiased bg-white">

  <!-- Header Sticky -->
  <header class="sticky top-0 z-[100] w-full bg-bege/95 backdrop-blur-md border-b border-bege-dark shadow-soft">
    <div class="container mx-auto px-4 sm:px-6 lg:px-12">
      <div class="flex items-center justify-between h-16 sm:h-20">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity shrink-0 z-[101]">
          <div class="w-9 h-9 sm:w-10 sm:h-10 bg-orange rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
          </div>
          <span class="text-base sm:text-xl font-black tracking-tight whitespace-nowrap">
            <span class="text-orange">ALUGUEL</span> <span class="text-brown">DE BRINQUEDOS</span>
          </span>
        </a>

        <!-- Navigation Desktop -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm font-semibold text-text-muted hover:text-orange transition-colors link-underline">Início</a>
          <a href="/sobre" class="text-sm font-semibold text-text-muted hover:text-orange transition-colors link-underline">Quem Somos</a>
          <a href="/brinquedos" class="text-sm font-semibold text-text-muted hover:text-orange transition-colors link-underline">Brinquedos</a>
          <a href="/blog" class="text-sm font-semibold text-text-muted hover:text-orange transition-colors link-underline">Blog</a>
          <a href="/contato" class="text-sm font-semibold text-text-muted hover:text-orange transition-colors link-underline">Contato</a>
          <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-press inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-orange rounded-xl hover:bg-orange-dark transition-colors">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Solicitar Orçamento
          </a>
        </nav>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="relative z-[9999] md:hidden p-2 -mr-2 text-brown hover:text-orange focus:outline-none" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="fixed inset-0 z-[9998] md:hidden pointer-events-none" aria-hidden="true" inert>
    <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm transition-opacity duration-300 opacity-0"></div>
    <div id="mobile-menu-panel" class="absolute top-0 right-0 h-full w-[85vw] max-w-[320px] bg-brown shadow-2xl translate-x-full transition-transform duration-300 ease-out pointer-events-auto">
      <div class="flex flex-col h-full px-5 py-16 space-y-1 overflow-y-auto">
        <a href="/" class="mobile-link block text-lg font-bold text-white/90 hover:text-orange-light transition-colors py-3 border-b border-white/15">Início</a>
        <a href="/sobre" class="mobile-link block text-lg font-bold text-white/90 hover:text-orange-light transition-colors py-3 border-b border-white/15">Quem Somos</a>
        <a href="/brinquedos" class="mobile-link block text-lg font-bold text-white/90 hover:text-orange-light transition-colors py-3 border-b border-white/15">Brinquedos</a>
        <a href="/blog" class="mobile-link block text-lg font-bold text-white/90 hover:text-orange-light transition-colors py-3 border-b border-white/15">Blog</a>
        <a href="/contato" class="mobile-link block text-lg font-bold text-white/90 hover:text-orange-light transition-colors py-3 border-b border-white/15">Contato</a>
        <div class="pt-6">
          <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full px-5 py-3.5 text-base font-bold text-white bg-orange rounded-xl hover:bg-orange-dark active:scale-95 transition-all shadow-xl shadow-orange/30">
            <svg class="w-5 h-5 mr-2 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Solicitar Orçamento
          </a>
        </div>
      </div>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="bg-brown text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-12 pt-16 sm:pt-24 pb-20 sm:pb-12">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10">
        <div>
          <h3 class="text-lg sm:text-xl font-black mb-4 text-white">{SITE_CONFIG.name}</h3>
          <p class="text-white/90 leading-relaxed text-sm sm:text-base">{SITE_CONFIG.tagline}. Aluguel de brinquedos inflaveis com seguranca, qualidade e preco justo.</p>
        </div>
        <div>
          <h4 class="text-base sm:text-lg font-bold mb-4 text-white">Navegacao</h4>
          <ul class="space-y-2 sm:space-y-3 text-white/90 text-sm sm:text-base">
            <li><a href="/" class="hover:text-white transition-all">Início</a></li>
            <li><a href="/sobre" class="hover:text-white transition-all">Quem Somos</a></li>
            <li><a href="/brinquedos" class="hover:text-white transition-all">Brinquedos</a></li>
            <li><a href="/blog" class="hover:text-white transition-all">Blog</a></li>
            <li><a href="/contato" class="hover:text-white transition-all">Contato</a></li>
          </ul>
        </div>
        <div class="lg:col-span-2">
          <h4 class="text-base sm:text-lg font-bold mb-4 text-white">Contato e Atendimento</h4>
          <div class="grid sm:grid-cols-2 gap-6">
            <ul class="space-y-2 sm:space-y-3 text-white/90 text-sm sm:text-base">
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-orange-light shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
                <span>{SITE_CONFIG.nap.whatsappDisplay}</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-orange-light shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/></svg>
                <span class="break-all">{SITE_CONFIG.nap.email}</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-orange-light shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
                <span>{SITE_CONFIG.nap.address.street}, {SITE_CONFIG.nap.address.number} — {SITE_CONFIG.nap.address.neighborhood}, {SITE_CONFIG.nap.address.city} — {SITE_CONFIG.nap.address.state}</span>
              </li>
            </ul>
            <ul class="space-y-2 sm:space-y-3 text-white/90 text-sm sm:text-base">
              <li>Segunda a Sexta: 8h as 20h</li>
              <li>Sabado: 9h as 18h</li>
              <li>Domingo: 10h as 16h</li>
              <li class="pt-2"><a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="text-orange-light font-semibold hover:underline">Atendimento de emergencia via WhatsApp</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-white/15 mt-10 sm:mt-16 pt-6 sm:pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-white/80 text-sm sm:text-base">&copy; {new Date().getFullYear()} {SITE_CONFIG.name}. Todos os direitos reservados.</p>
        <div class="flex items-center gap-4 sm:gap-6 text-sm text-white/80">
          <a href="/privacidade" class="hover:text-white transition-all">Politica de Privacidade</a>
          <a href="/termos" class="hover:text-white transition-all">Termos de Uso</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Botao Flutuante WhatsApp -->
  <WhatsAppBtn />

  <script is:inline>
    // Scroll reveal animation
    (function() {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal, .stagger-children').forEach(function(el) {
        observer.observe(el);
      });
    })();

    // Header shadow on scroll
    (function() {
      var header = document.querySelector('header');
      if (!header) return;
      function updateHeader() {
        if (window.scrollY > 10) {
          header.classList.add('shadow-soft-lg');
        } else {
          header.classList.remove('shadow-soft-lg');
        }
      }
      window.addEventListener('scroll', updateHeader, { passive: true });
      updateHeader();
    })();
  </script>
  <script is:inline>
    (function() {
      var btn = document.getElementById('mobile-menu-btn');
      var menu = document.getElementById('mobile-menu');
      var panel = document.getElementById('mobile-menu-panel');
      var backdrop = document.getElementById('mobile-menu-backdrop');
      var iconOpen = document.getElementById('menu-icon-open');
      var iconClose = document.getElementById('menu-icon-close');

      if (!btn || !menu || !panel) return;

      function openMenu() {
        menu.classList.remove('pointer-events-none');
        menu.classList.add('pointer-events-auto');
        menu.removeAttribute('inert');
        panel.classList.remove('translate-x-full');
        if (backdrop) {
          backdrop.classList.remove('opacity-0');
          backdrop.classList.add('opacity-100');
        }
        menu.setAttribute('aria-hidden', 'false');
        btn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        if (iconOpen) iconOpen.classList.add('hidden');
        if (iconClose) iconClose.classList.remove('hidden');
      }

      function closeMenu() {
        panel.classList.add('translate-x-full');
        if (backdrop) {
          backdrop.classList.add('opacity-0');
          backdrop.classList.remove('opacity-100');
        }
        menu.setAttribute('aria-hidden', 'true');
        menu.setAttribute('inert', '');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        if (iconOpen) iconOpen.classList.remove('hidden');
        if (iconClose) iconClose.classList.add('hidden');
        setTimeout(function() {
          menu.classList.add('pointer-events-none');
          menu.classList.remove('pointer-events-auto');
        }, 300);
      }

      btn.addEventListener('click', function() {
        var isOpen = !panel.classList.contains('translate-x-full');
        if (isOpen) closeMenu();
        else openMenu();
      });

      if (backdrop) {
        backdrop.addEventListener('click', closeMenu);
      }

      menu.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !panel.classList.contains('translate-x-full')) {
          closeMenu();
        }
      });
    })();
  </script>
</body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  section {
    @apply py-16 md:py-20 lg:py-24;
  }

  /* Typography: display font for headings */
  h1, h2, h3 {
    font-family: 'Fraunces', Georgia, serif;
  }

  /* Grain texture overlay on beige sections */
  .bg-bege, .bg-bege-mid {
    position: relative;
  }
  .bg-bege::before, .bg-bege-mid::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.035;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px 200px;
  }

  /* Organic blob shapes */
  .blob-shape {
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
  }

  /* Cards with colored shadow hover */
  .card-hover {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
  }
  .card-hover:hover {
    transform: translateY(-4px) rotate(0.5deg);
    box-shadow: 0 12px 32px -8px rgba(232, 98, 42, 0.15);
  }

  /* Buttons with press effect */
  .btn-press {
    transition: transform 0.15s ease, box-shadow 0.3s ease;
  }
  .btn-press:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(232, 98, 42, 0.3);
  }
  .btn-press:active {
    transform: translateY(0) scale(0.98);
  }

  /* Link underline animation */
  .link-underline {
    position: relative;
  }
  .link-underline::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #E8622A;
    transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    border-radius: 2px;
  }
  .link-underline:hover::after {
    width: 100%;
  }

  /* Fade-in animation for scroll reveals */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger children */
  .stagger-children > * {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .stagger-children.visible > *:nth-child(1) { transition-delay: 0.05s; opacity: 1; transform: translateY(0); }
  .stagger-children.visible > *:nth-child(2) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
  .stagger-children.visible > *:nth-child(3) { transition-delay: 0.15s; opacity: 1; transform: translateY(0); }
  .stagger-children.visible > *:nth-child(4) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
  .stagger-children.visible > *:nth-child(5) { transition-delay: 0.25s; opacity: 1; transform: translateY(0); }
  .stagger-children.visible > *:nth-child(6) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }

  /* Decorative dots pattern */
  .dots-pattern {
    background-image: radial-gradient(circle, rgba(232, 98, 42, 0.08) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  /* Smooth image hover */
  .img-zoom {
    overflow: hidden;
  }
  .img-zoom img {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .img-zoom:hover img {
    transform: scale(1.05);
  }

  /* Selection color */
  ::selection {
    background: rgba(232, 98, 42, 0.2);
    color: #2C1810;
  }

  /* Scrollbar styling */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #FDF6EE;
  }
  ::-webkit-scrollbar-thumb {
    background: #E8D5BC;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #D9BFA0;
  }
</style>
