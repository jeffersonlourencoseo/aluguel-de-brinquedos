---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contato | Aluguel de Brinquedos - Orçamento Grátis"
  description="Entre em contato para alugar brinquedos para festas. Orçamento gratuito e sem compromisso. Atendemos toda a região metropolitana."
>

  <!-- HERO -->
  <section class="bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <span class="inline-block text-sm font-bold text-secondary uppercase tracking-wider mb-4">Contato</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-secondary leading-tight mb-16">
          Faça Seu Orçamento Grátis Agora Mesmo
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl">
          Entre em contato pelo WhatsApp, telefone ou preencha o formulário. Responderemos em até 30 minutos com seu orçamento personalizado.
        </p>
      </div>
    </div>
  </section>

  <!-- NAP + FORMULÁRIO -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-3 gap-10">
        <!-- FORMULÁRIO -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-black text-secondary mb-8">Envie sua Mensagem</h2>
          <form class="space-y-6" action="#" method="POST">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="nome" class="block text-sm font-bold text-gray-700 mb-2">Nome Completo *</label>
                <input type="text" id="nome" name="nome" required class="w-full px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-gray-900 placeholder-gray-400" placeholder="Seu nome completo" />
              </div>
              <div>
                <label for="telefone" class="block text-sm font-bold text-gray-700 mb-2">Telefone / WhatsApp *</label>
                <input type="tel" id="telefone" name="telefone" required class="w-full px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-gray-900 placeholder-gray-400" placeholder="(11) 99999-9999" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-bold text-gray-700 mb-2">E-mail *</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-gray-900 placeholder-gray-400" placeholder="seu@email.com" />
            </div>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="data" class="block text-sm font-bold text-gray-700 mb-2">Data do Evento</label>
                <input type="date" id="data" name="data" class="w-full px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-gray-900" />
              </div>
              <div>
                <label for="brinquedo" class="block text-sm font-bold text-gray-700 mb-2">Brinquedo de Interesse</label>
                <select id="brinquedo" name="brinquedo" class="w-full px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-gray-900">
                  <option value="">Selecione...</option>
                  <option value="pula-pula">Pula-Pula Inflável</option>
                  <option value="escorregador">Escorregador Gigante</option>
                  <option value="piscina-bolinhas">Piscina de Bolinhas</option>
                  <option value="cama-elastica">Cama Elástica</option>
                  <option value="toboga">Tobogã Inflável</option>
                  <option value="futebol-sabao">Futebol de Sabão</option>
                  <option value="pacote">Pacote Personalizado</option>
                </select>
              </div>
            </div>
            <div>
              <label for="mensagem" class="block text-sm font-bold text-gray-700 mb-2">Mensagem</label>
              <textarea id="mensagem" name="mensagem" rows="5" class="w-full px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-gray-900 placeholder-gray-400 resize-none" placeholder="Conte mais sobre seu evento: local, número de crianças, duração..."></textarea>
            </div>
            <button type="submit" class="w-full md:w-auto inline-flex items-center justify-center px-10 py-5 text-lg font-bold text-secondary bg-primary rounded-xl hover:bg-primary-400 hover:scale-105 active:scale-95 transition-all shadow-lg shadow-primary/20 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Enviar Pedido de Orçamento
            </button>
          </form>
        </div>

        <!-- NAP + INFO -->
        <div class="space-y-8">
          <!-- Card Contato -->
          <div class="bg-gray-50 rounded-2xl p-10 hover:shadow-lg hover:shadow-primary/10 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-xl font-black text-secondary mb-6">Fale Conosco</h3>
            <div class="space-y-4">
              <a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-gray-600 hover:text-secondary transition-colors">
                <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0"><svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></div>
                <div><div class="font-bold text-secondary">WhatsApp</div><div class="text-sm">(11) 99999-9999</div></div>
              </a>
              <a href="tel:+551133333333" class="flex items-center gap-4 text-gray-600 hover:text-secondary transition-colors">
                <div class="w-12 h-12 bg-primary/20 rounded-xl flex items-center justify-center flex-shrink-0"><svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg></div>
                <div><div class="font-bold text-secondary">Telefone</div><div class="text-sm">(11) 3333-3333</div></div>
              </a>
              <div class="flex items-center gap-4 text-gray-600">
                <div class="w-12 h-12 bg-primary/20 rounded-xl flex items-center justify-center flex-shrink-0"><svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
                <div><div class="font-bold text-secondary">E-mail</div><div class="text-sm">contato@alugueldebrinquedos.com.br</div></div>
              </div>
            </div>
          </div>

          <!-- Card Endereço / Atendimento -->
          <div class="bg-secondary rounded-2xl p-10 text-white hover:shadow-lg hover:shadow-secondary/30 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-xl font-black mb-4">Horário de Atendimento</h3>
            <div class="space-y-2 text-secondary-100">
              <div class="flex justify-between"><span>Segunda a Sexta</span><span class="font-bold">8h às 20h</span></div>
              <div class="flex justify-between"><span>Sábado</span><span class="font-bold">9h às 18h</span></div>
              <div class="flex justify-between"><span>Domingo</span><span class="font-bold">10h às 16h</span></div>
            </div>
            <div class="mt-6 pt-6 border-t border-secondary-700">
              <p class="text-sm text-secondary-200">Atendimento de emergência disponível via WhatsApp fora do horário comercial.</p>
            </div>
          </div>

          <!-- Card Localização -->
          <div class="bg-gray-50 rounded-2xl p-10 hover:shadow-lg hover:shadow-primary/10 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-xl font-black text-secondary mb-4">Atendimento Regional</h3>
            <p class="text-gray-600 mb-4">Entrega e montagem inclusas nas cidades da região metropolitana:</p>
            <ul class="text-gray-600 space-y-1">
              <li>São Paulo — todas as zonas</li>
              <li>Guarulhos, Osasco, Santo André</li>
              <li>São Bernardo, São Caetano, Mauá, Diadema</li>
            </ul>
            <a href="/localizacao" class="inline-flex items-center mt-4 text-sm font-bold text-secondary hover:text-primary transition-colors">
              Ver todas as cidades atendidas
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
