---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';
---

<Layout
  title="Contato | Aluguel de Brinquedos - Orçamento Grátis"
  description="Entre em contato para alugar brinquedos para festas. Orçamento gratuito e sem compromisso. Atendemos toda a região metropolitana."
>

  <!-- HERO -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Contato</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-text-main leading-tight mb-16">
          Faça Seu Orçamento Grátis Agora Mesmo
        </h1>
        <p class="text-xl md:text-2xl text-text-muted leading-relaxed max-w-3xl">
          Entre em contato pelo WhatsApp, telefone ou preencha o formulário. Responderemos em até 30 minutos com seu orçamento personalizado.
        </p>
      </div>
    </div>
  </section>

  <!-- CTAS PRINCIPAIS -->
  <section class="bg-orange-dark">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6">Fale Conosco Agora</h2>
        <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
          Atendimento rápido via WhatsApp ou telefone. Se preferir, preencha o formulário na próxima seção.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-orange-dark bg-bege rounded-xl hover:bg-white transition-all">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chamar no WhatsApp
          </a>
          <a href={`tel:${SITE_CONFIG.nap.telephone}`} class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-transparent border-2 border-white/30 rounded-xl hover:bg-white/10 transition-all">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Ligar Agora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULÁRIO + INFO -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10">
        <!-- FORMULÁRIO -->
        <div class="lg:col-span-2">
          <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Formulário</span>
          <h2 class="text-4xl md:text-5xl font-bold text-text-main mb-8">Envie sua Mensagem</h2>
          <form class="space-y-6" action="#" method="POST">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="nome" class="block text-xs font-bold text-text-main mb-2">Nome Completo *</label>
                <input type="text" id="nome" name="nome" required class="w-full px-4 py-3 bg-bege border border-bege-dark rounded-xl focus:outline-none focus:ring-2 focus:ring-orange text-text-main placeholder-text-muted/50" placeholder="Seu nome completo" />
              </div>
              <div>
                <label for="telefone" class="block text-xs font-bold text-text-main mb-2">Telefone / WhatsApp *</label>
                <input type="tel" id="telefone" name="telefone" required class="w-full px-4 py-3 bg-bege border border-bege-dark rounded-xl focus:outline-none focus:ring-2 focus:ring-orange text-text-main placeholder-text-muted/50" placeholder={SITE_CONFIG.nap.whatsappDisplay} />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-bold text-text-main mb-2">E-mail *</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-bege border border-bege-dark rounded-xl focus:outline-none focus:ring-2 focus:ring-orange text-text-main placeholder-text-muted/50" placeholder="seu@email.com" />
            </div>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="data" class="block text-xs font-bold text-text-main mb-2">Data do Evento</label>
                <input type="date" id="data" name="data" class="w-full px-4 py-3 bg-bege border border-bege-dark rounded-xl focus:outline-none focus:ring-2 focus:ring-orange text-text-main" />
              </div>
              <div>
                <label for="brinquedo" class="block text-xs font-bold text-text-main mb-2">Brinquedo de Interesse</label>
                <select id="brinquedo" name="brinquedo" class="w-full px-4 py-3 bg-bege border border-bege-dark rounded-xl focus:outline-none focus:ring-2 focus:ring-orange text-text-main">
                  <option value="">Selecione...</option>
                  <option value="pula-pula">Pula-Pula Inflável</option>
                  <option value="escorregador">Escorregador Gigante</option>
                  <option value="piscina-bolinhas">Piscina de Bolinhas</option>
                  <option value="cama-elastica">Cama Elástica</option>
                  <option value="toboga">Tobogã Inflável</option>
                  <option value="futebol-sabao">Futebol de Sabão</option>
                  <option value="pacote">Pacote Personalizado</option>
                </select>
              </div>
            </div>
            <div>
              <label for="mensagem" class="block text-xs font-bold text-text-main mb-2">Mensagem</label>
              <textarea id="mensagem" name="mensagem" rows="5" class="w-full px-4 py-3 bg-bege border border-bege-dark rounded-xl focus:outline-none focus:ring-2 focus:ring-orange text-text-main placeholder-text-muted/50 resize-none" placeholder="Conte mais sobre seu evento: local, número de crianças, duração..."></textarea>
            </div>
            <button type="submit" class="inline-flex items-center justify-center px-6 py-3 text-lg font-semibold text-white bg-orange rounded-xl hover:bg-orange-dark transition-all">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Enviar Pedido de Orçamento
            </button>
          </form>
        </div>

        <!-- SIDEBAR INFO -->
        <div class="space-y-6">
          <!-- Card Endereço -->
          <div class="bg-white border border-bege-dark rounded-[10px] p-6">
            <h3 class="text-sm font-bold text-text-main mb-4">Endereço</h3>
            <div class="flex items-start gap-3 text-text-muted">
              <svg class="w-5 h-5 text-orange shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <div>
                <p class="font-bold text-text-main text-sm">{SITE_CONFIG.nap.address.street}, {SITE_CONFIG.nap.address.number}</p>
                <p class="text-xs">{SITE_CONFIG.nap.address.neighborhood}</p>
                <p class="text-xs">{SITE_CONFIG.nap.address.city} — {SITE_CONFIG.nap.address.state}, CEP {SITE_CONFIG.nap.address.postalCode}</p>
              </div>
            </div>
          </div>

          <!-- Card Horário -->
          <div class="bg-orange-dark rounded-[10px] p-6 text-white">
            <h3 class="text-sm font-bold mb-4">Horário de Atendimento</h3>
            <div class="space-y-2 text-white/80 text-sm">
              <div class="flex justify-between"><span>Segunda a Sexta</span><span class="font-bold">8h às 20h</span></div>
              <div class="flex justify-between"><span>Sábado</span><span class="font-bold">9h às 18h</span></div>
              <div class="flex justify-between"><span>Domingo</span><span class="font-bold">10h às 16h</span></div>
            </div>
            <div class="mt-4 pt-4 border-t border-white/15">
              <p class="text-xs text-white/60">Atendimento de emergência disponível via WhatsApp fora do horário comercial.</p>
            </div>
          </div>

          <!-- Card Cidades Atendidas -->
          <div class="bg-white border border-bege-dark rounded-[10px] p-6">
            <h3 class="text-sm font-bold text-text-main mb-4">Cidades Atendidas</h3>
            <p class="text-xs text-text-muted mb-4">Entrega e montagem inclusas em toda a região metropolitana:</p>
            <ul class="text-xs text-text-muted space-y-2">
              {SITE_CONFIG.areaServed.map((area) => (
                <li class="flex items-center gap-2">
                  <svg class="w-3 h-3 text-orange shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
                  {area.city} — {area.state}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
