---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_CONFIG } from '../data/config';
import { getCollection } from 'astro:content';
const brinquedos = await getCollection('brinquedos');
---

<Layout
  title="Catálogo de Brinquedos para Aluguel no Rio de Janeiro | Aluguel de Brinquedos RJ"
  description="Catálogo completo de aluguel de brinquedos no Rio de Janeiro. Pula-pula, escorregador inflável, cama elástica, piscina de bolinhas e futebol de sabão para festa infantil. Reserve agora com entrega grátis na cidade do Rio de Janeiro e região metropolitana do RJ!"
>

  <!-- HERO -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <Breadcrumb items={[
          { label: 'Início', url: '/' },
          { label: 'Brinquedos', url: '/brinquedos' },
        ]} />
        <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Catálogo Completo</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-text-main leading-tight mb-16">
          Aluguel de Brinquedos no Rio de Janeiro: Catálogo Completo
        </h1>
        <p class="text-xl md:text-2xl text-text-muted leading-relaxed max-w-3xl">
          Catálogo completo de brinquedos infláveis para festa infantil no Rio de Janeiro. Locação de brinquedos para eventos: pula-pula, escorregador inflável, cama elástica, piscina de bolinhas e futebol de sabão — todos higienizados, seguros e entregues com montagem grátis na cidade do Rio de Janeiro e região metropolitana do RJ.
        </p>
      </div>
    </div>
  </section>

  <!-- CATÁLOGO -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10">
        {brinquedos.map((b) => (
          <div class="bg-white border border-bege-dark rounded-[10px] p-6 hover:shadow-md hover:border-orange-light transition cursor-default">
            <div class="text-5xl mb-4">{b.data.icon}</div>
            <h3 class="text-sm font-bold text-orange-dark mb-2">{b.data.title}</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-4">{b.data.description}</p>
            {b.data.minAge && (
              <ul class="text-xs text-text-muted space-y-1 mb-4">
                <li>✅ A partir de {b.data.minAge}</li>
              </ul>
            )}
            <div class="flex justify-end">
              <a href={`/brinquedos/${b.slug}`} class="text-xs font-semibold text-orange-dark border border-orange bg-transparent rounded-md px-3 py-1 hover:bg-bege transition">Ver detalhes</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA PACOTE -->
  <section class="bg-orange-dark">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6">Quer um Pacote Personalizado?</h2>
        <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
          Monte seu pacote com 3 ou mais brinquedos e ganhe desconto especial. Entre em contato e faça seu orçamento gratuito.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-orange-dark bg-bege rounded-xl hover:bg-white transition-all">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Falar no WhatsApp
          </a>
          <a href="/contato" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-transparent border-2 border-white/30 rounded-xl hover:bg-white/10 transition-all">Formulário de Contato</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
