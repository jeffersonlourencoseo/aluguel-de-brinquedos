---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';
---

<Layout
  title="Localização e Atendimento | Aluguel de Brinquedos"
  description="Atendemos toda a região metropolitana com entrega e montagem de brinquedos infláveis. Confira as cidades atendidas e solicite seu orçamento."
>

  <section class="bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <span class="inline-block text-sm font-bold text-secondary uppercase tracking-wider mb-4">Atendimento Regional</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-secondary leading-tight mb-10">
          Aluguel de Brinquedos em Toda a Região Metropolitana
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl">
          Entregamos e montamos brinquedos infláveis em várias cidades da região. Consulte disponibilidade para sua localidade e garanta a diversão da festa.
        </p>

        <div class="mt-8 inline-flex items-start gap-3 bg-white border border-gray-200 rounded-xl px-6 py-4 shadow-sm">
          <svg class="w-6 h-6 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <div class="text-gray-700">
            <p class="font-bold text-secondary">{SITE_CONFIG.nap.address.street}, {SITE_CONFIG.nap.address.number} - {SITE_CONFIG.nap.address.neighborhood}</p>
            <p>{SITE_CONFIG.nap.address.city} - {SITE_CONFIG.nap.address.state}, CEP {SITE_CONFIG.nap.address.postalCode}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-secondary mb-6">Cidades Atendidas</h2>
        <p class="text-lg text-gray-600">Entrega e montagem inclusas no orçamento para as seguintes regiões:</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">São Paulo</h3>
          <p class="text-sm text-gray-500 mt-1">Todas as zonas</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">Guarulhos</h3>
          <p class="text-sm text-gray-500 mt-1">Toda a cidade</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">Osasco</h3>
          <p class="text-sm text-gray-500 mt-1">Toda a cidade</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">Santo André</h3>
          <p class="text-sm text-gray-500 mt-1">Toda a cidade</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">São Bernardo</h3>
          <p class="text-sm text-gray-500 mt-1">Toda a cidade</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">São Caetano</h3>
          <p class="text-sm text-gray-500 mt-1">Toda a cidade</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">Mauá</h3>
          <p class="text-sm text-gray-500 mt-1">Toda a cidade</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-secondary">Diadema</h3>
          <p class="text-sm text-gray-500 mt-1">Toda a cidade</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-secondary">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-6">Sua Cidade Não Está na Lista?</h2>
        <p class="text-lg text-secondary-100 mb-10 max-w-2xl mx-auto">
          Entre em contato! Dependendo da distância, também podemos atender. Consulte disponibilidade e condições especiais para cidades da Grande São Paulo.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-secondary bg-primary rounded-xl hover:bg-primary-400 hover:scale-105 active:scale-95 transition-all shadow-xl shadow-primary/30">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Consultar Disponibilidade
          </a>
          <a href="/contato" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white bg-white/10 border-2 border-white/20 rounded-xl hover:bg-white/20 hover:scale-105 active:scale-95 transition-all">Formulário de Contato</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
