---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export const prerender = true;

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/blog/*.{jpeg,jpg,png,webp}');
const imageMap: Record<string, () => Promise<{ default: ImageMetadata }>> = {};
for (const [path, mod] of Object.entries(images)) {
  const filename = path.split(/[\\/]/).pop() || '';
  imageMap[filename] = mod;
}
---

<Layout
  title="Blog de Aluguel de Brinquedos no Rio de Janeiro | Dicas para Festa Infantil"
  description="Dicas e tendências sobre aluguel de brinquedos para festa infantil no Rio de Janeiro. Aprenda a escolher pula-pula, escorregador, cama elástica e organizar eventos inesquecíveis no RJ."
>

  <!-- HERO -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <Breadcrumb items={[
          { label: 'Início', url: '/' },
          { label: 'Blog', url: '/blog' },
        ]} />
        <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Blog</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-text-main leading-tight mb-16">
          Blog de Aluguel de Brinquedos no Rio de Janeiro: Dicas para Festas Infantis
        </h1>
        <p class="text-xl md:text-2xl text-text-muted leading-relaxed max-w-3xl">
          Conteúdo exclusivo sobre aluguel de brinquedos no Rio de Janeiro para ajudar você a organizar festas inesquecíveis. Dicas de pula-pula, escorregador, cama elástica e muito mais para festa infantil na região metropolitana do RJ.
        </p>
      </div>
    </div>
  </section>

  <!-- LISTAGEM -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10">
        {posts.map((post) => {
          const filename = post.data.image ? post.data.image.replace(/^.*[\\\/]/, '') : null;
          const imgSrc = filename ? imageMap[filename] : null;
          return (
            <article class="bg-white border border-bege-dark rounded-[10px] overflow-hidden hover:shadow-sm hover:border-orange-light transition cursor-default">
              <div class="h-48 bg-bege-mid overflow-hidden">
                {imgSrc ? (
                  <Image
                    src={imgSrc()}
                    alt={post.data.title}
                    width={400}
                    height={220}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="h-full flex items-center justify-center">
                    <span class="text-4xl">🎉</span>
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class="inline-block px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">{post.data.category}</span>
                  <span class="text-xs text-text-muted">{post.data.readTime}</span>
                </div>
                <h2 class="text-sm font-bold text-text-main mb-2">{post.data.title}</h2>
                <p class="text-xs text-text-muted leading-relaxed mb-4">{post.data.description}</p>
                <div class="flex items-center justify-between">
                  <span class="text-xs text-text-muted">{new Date(post.data.date).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}</span>
                  <a href={`/blog/${post.slug}`} class="text-xs font-semibold text-orange hover:text-orange-dark transition-colors flex items-center gap-1">
                    Ler mais
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="bg-orange-dark">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6">Quer Receber Novidades?</h2>
        <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
          Cadastre-se para receber dicas exclusivas, promoções e novidades sobre aluguel de brinquedos diretamente no seu e-mail.
        </p>
        <form class="flex flex-col sm:flex-row gap-4 justify-center max-w-lg mx-auto">
          <input type="email" placeholder="seu@email.com" class="flex-1 px-4 py-3 rounded-xl text-text-main bg-white border-0 focus:outline-none focus:ring-2 focus:ring-orange" />
          <button type="submit" class="inline-flex items-center justify-center px-6 py-3 text-lg font-semibold text-orange-dark bg-bege rounded-xl hover:bg-white transition-all">
            Cadastrar
          </button>
        </form>
      </div>
    </div>
  </section>

</Layout>
