---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection('brinquedos');
  return items.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<Layout title={item.data.title} description={item.data.description}>

  <!-- HERO SERVIÇO -->
  <section class="bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6">
          {item.data.popular && (
            <span class="inline-block px-4 py-1 text-sm font-bold text-secondary bg-primary rounded-full">Mais Popular</span>
          )}
          <span class="inline-block px-4 py-1 text-sm font-bold text-secondary bg-gray-100 rounded-full">A partir de {item.data.minAge}</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-secondary leading-tight mb-16">
          {item.data.title}
        </h1>
        <div class="flex items-center gap-6 mb-8">
          <span class="text-5xl">{item.data.icon}</span>
          <div>
            <span class="text-3xl font-black text-primary">{item.data.price}</span>
            <div class="text-sm text-gray-500">Montagem e retirada inclusas</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ESPECIFICAÇÕES + CONTEÚDO -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10">
        <!-- CONTEÚDO PRINCIPAL -->
        <div class="lg:col-span-2">
          <div class="prose prose-lg max-w-none prose-headings:text-secondary prose-a:text-secondary hover:prose-a:text-primary-600">
            <Content />
          </div>
        </div>

        <!-- SIDEBAR -->
        <div class="space-y-8">
          <!-- Card Reserva -->
          <div class="bg-secondary rounded-2xl p-8 text-white hover:shadow-lg hover:shadow-secondary/30 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-xl font-black mb-4">Reserve Agora</h3>
            <p class="text-secondary-100 mb-6">Garanta a diversão do seu evento. Atendemos toda a região metropolitana.</p>
            <a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full px-6 py-4 text-base font-bold text-secondary bg-primary rounded-xl hover:bg-primary-400 transition-colors mb-3">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Reservar pelo WhatsApp
            </a>
            <a href="tel:+5511999999999" class="inline-flex items-center justify-center w-full px-6 py-4 text-base font-bold text-white bg-white/10 border-2 border-white/20 rounded-xl hover:bg-white/20 transition-colors">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Ligar Agora
            </a>
          </div>

          <!-- Especificações -->
          <div class="bg-gray-50 rounded-2xl p-8 hover:shadow-lg hover:shadow-primary/10 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-lg font-black text-secondary mb-4">Detalhes Rápidos</h3>
            <div class="space-y-3">
              <div class="flex justify-between"><span class="text-gray-600">Preço</span><span class="font-bold text-secondary">{item.data.price}</span></div>
              <div class="flex justify-between"><span class="text-gray-600">Idade mínima</span><span class="font-bold text-secondary">{item.data.minAge}</span></div>
              <div class="flex justify-between"><span class="text-gray-600">Montagem</span><span class="font-bold text-secondary">Inclusa</span></div>
              <div class="flex justify-between"><span class="text-gray-600">Higienização</span><span class="font-bold text-secondary">Garantida</span></div>
            </div>
          </div>

          <!-- Tags -->
          <div class="bg-gray-50 rounded-2xl p-8 hover:shadow-lg hover:shadow-primary/10 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-lg font-black text-secondary mb-4">Tags</h3>
            <div class="flex flex-wrap gap-2">
              {item.data.tags.map(tag => (
                <span class="px-3 py-1 text-sm font-bold text-secondary bg-primary/20 rounded-full">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFÍCIOS / APLICAÇÕES -->
  <section class="bg-gray-50">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-secondary mb-6">Ideal para Estes Eventos</h2>
        <p class="text-lg text-gray-600">Nossos brinquedos são perfeitos para diversas ocasiões e públicos.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
        <div class="bg-white rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="text-4xl mb-4">🎂</div>
          <h3 class="text-lg font-bold text-secondary">Aniversários</h3>
          <p class="text-sm text-gray-500 mt-2">Festa infantil inesquecível</p>
        </div>
        <div class="bg-white rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="text-4xl mb-4">🏫</div>
          <h3 class="text-lg font-bold text-secondary">Escolas</h3>
          <p class="text-sm text-gray-500 mt-2">Eventos escolares e formaturas</p>
        </div>
        <div class="bg-white rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="text-4xl mb-4">🏢</div>
          <h3 class="text-lg font-bold text-secondary">Corporativos</h3>
          <p class="text-sm text-gray-500 mt-2">Dia das crianças no trabalho</p>
        </div>
        <div class="bg-white rounded-2xl p-8 text-center hover:shadow-lg hover:shadow-primary/10 hover:scale-105 active:scale-95 transition-all cursor-default">
          <div class="text-4xl mb-4">🏡</div>
          <h3 class="text-lg font-bold text-secondary">Condomínios</h3>
          <p class="text-sm text-gray-500 mt-2">Festa para moradores</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-secondary">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-6">Garanta a Diversão do Seu Evento</h2>
        <p class="text-lg text-secondary-100 mb-10 max-w-2xl mx-auto">Não perca tempo! Entre em contato agora e faça sua reserva. Atendemos toda a região metropolitana com entrega e montagem inclusas.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-10 py-5 text-lg font-bold text-secondary bg-primary rounded-xl hover:bg-primary-400 hover:scale-105 active:scale-95 transition-all shadow-xl shadow-primary/30">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Reservar pelo WhatsApp
          </a>
          <a href="tel:+5511999999999" class="inline-flex items-center justify-center px-10 py-5 text-lg font-bold text-white bg-white/10 border-2 border-white/20 rounded-xl hover:bg-white/20 hover:scale-105 active:scale-95 transition-all">Ligar Agora</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
