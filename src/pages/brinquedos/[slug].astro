---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';
import SchemaProduct from '../../components/SchemaProduct.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection('brinquedos');
  return items.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const pageUrl = `${SITE_CONFIG.url}/brinquedos/${item.slug}`;

const faqs = [
  {
    question: `Precisa de energia elétrica para usar o ${item.data.title}?`,
    answer: 'A maioria dos brinquedos infláveis precisa de uma tomada 110V ou 220V para o inflador funcionar. Caso o local não tenha energia, oferecemos o aluguel de gerador por um valor adicional.',
  },
  {
    question: `Qual o espaço mínimo necessário para o ${item.data.title}?`,
    answer: 'O espaço varia conforme o brinquedo. Recomendamos um perímetro de segurança de pelo menos 1 metro ao redor. Entre em contato pelo WhatsApp e informamos as medidas exatas do modelo escolhido.',
  },
  {
    question: 'A montagem está realmente inclusa no valor?',
    answer: 'Sim! Nossa equipe vai até o local do evento, monta o brinquedo, faz os testes de segurança e retira após o término. Tudo incluso no preço do aluguel.',
  },
  {
    question: 'Como garantem a segurança e a higienização?',
    answer: 'Todos os brinquedos passam por manutenção preventiva mensal e higienização completa com produtos adequados após cada evento. Além disso, nossa equipe supervisiona a montagem e orienta sobre o uso correto.',
  },
  {
    question: 'Quanto tempo antes preciso reservar?',
    answer: 'Recomendamos reservar com pelo menos 7 dias de antecedência, especialmente em fins de semana e feriados. Para datas de alta demanda (dezembro, julho), quanto antes, melhor.',
  },
];
---

<Layout title={`Aluguel de ${item.data.title} no Rio de Janeiro | Aluguel de Brinquedos RJ`} description={item.data.description}>
  <Fragment slot="head">
    <SchemaProduct
      name={item.data.title}
      description={item.data.description}
      url={pageUrl}
      price={item.data.price}
      minAge={item.data.minAge}
      tags={item.data.tags}
    />
  </Fragment>

  <!-- HERO SERVIÇO -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl reveal">
        <Breadcrumb items={[
          { label: 'Início', url: '/' },
          { label: 'Brinquedos', url: '/brinquedos' },
          { label: item.data.title, url: pageUrl },
        ]} />
        <div class="flex items-center gap-3 mb-6">
          {item.data.popular && (
            <span class="inline-block px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Mais Popular</span>
          )}
          <span class="inline-block px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">A partir de {item.data.minAge}</span>
        </div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-text-main leading-tight mb-16">
          Aluguel de {item.data.title} no Rio de Janeiro
        </h1>
        <div class="flex items-center gap-4 mb-8">
          {item.data.image ? (
            <img src={item.data.image} alt={`${item.data.title} para aluguel no Rio de Janeiro`} class="w-16 h-16 rounded-xl object-cover bg-bege-mid" width="64" height="64" loading="eager" />
          ) : (
            <span class="text-4xl">{item.data.icon}</span>
          )}
          <div>
            <div class="text-sm text-text-muted">Montagem e retirada inclusas</div>
          </div>
        </div>
        {item.data.image && (
          <div class="aspect-video overflow-hidden rounded-2xl bg-bege-mid mb-12">
            <img src={item.data.image} alt={`${item.data.title} para aluguel no Rio de Janeiro`} class="w-full h-full object-cover img-zoom" width="1200" height="675" loading="eager" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ESPECIFICAÇÕES + CONTEÚDO -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10">
        <!-- CONTEÚDO PRINCIPAL -->
        <div class="lg:col-span-2">
          <div class="prose prose-lg max-w-none prose-headings:text-orange-dark prose-a:text-orange-dark hover:prose-a:text-orange">
            <Content />
          </div>
        </div>

        <!-- SIDEBAR -->
        <div class="space-y-6">
          <!-- Card Reserva -->
          <div class="bg-orange-dark rounded-2xl p-6 text-white">
            <h3 class="text-xl font-bold mb-2">Reserve {item.data.title} no Rio de Janeiro</h3>
            <p class="text-sm text-white/80 mb-4">Garanta a diversão do seu evento. Atendemos toda a cidade do Rio de Janeiro e região metropolitana do RJ.</p>
            <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full px-4 py-3 text-sm font-semibold text-orange-dark bg-bege rounded-xl hover:bg-white transition-all btn-press mb-2">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Reservar pelo WhatsApp
            </a>
            <a href={`tel:${SITE_CONFIG.nap.telephone}`} class="inline-flex items-center justify-center w-full px-4 py-3 text-sm font-semibold text-white bg-white/10 border border-white/20 rounded-xl hover:bg-white/20 transition-all btn-press">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Ligar Agora
            </a>
          </div>

          <!-- Especificações -->
          <div class="bg-white border border-bege-dark rounded-2xl p-6">
            <h3 class="text-sm font-bold text-text-main mb-4">Detalhes Rápidos</h3>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between"><span class="text-text-muted">Idade mínima</span><span class="font-bold text-text-main">{item.data.minAge}</span></div>
              <div class="flex justify-between"><span class="text-text-muted">Montagem</span><span class="font-bold text-text-main">Inclusa</span></div>
              <div class="flex justify-between"><span class="text-text-muted">Higienização</span><span class="font-bold text-text-main">Garantida</span></div>
            </div>
          </div>

          <!-- Tags -->
          <div class="bg-white border border-bege-dark rounded-2xl p-6">
            <h3 class="text-sm font-bold text-text-main mb-4">Tags</h3>
            <div class="flex flex-wrap gap-2">
              {item.data.tags.map(tag => (
                <span class="px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">{tag}</span>
              ))}
            </div>
          </div>

          <SchemaFAQ questions={faqs} />
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFÍCIOS / APLICAÇÕES -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Aplicações</span>
        <h2 class="text-4xl md:text-5xl font-bold text-text-main mb-6">{item.data.title} no Rio de Janeiro: Ideal para Estes Eventos</h2>
        <p class="text-lg text-text-muted">Nossos brinquedos são perfeitos para diversas ocasiões e públicos.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 reveal stagger-children">
        <div class="bg-white border border-bege-dark rounded-2xl p-6 text-center card-hover cursor-default">
          <div class="text-4xl mb-3">🎂</div>
          <h3 class="text-sm font-bold text-text-main">Aniversários</h3>
          <p class="text-xs text-text-muted mt-1">Festa infantil inesquecível</p>
        </div>
        <div class="bg-white border border-bege-dark rounded-2xl p-6 text-center card-hover cursor-default">
          <div class="text-4xl mb-3">🏫</div>
          <h3 class="text-sm font-bold text-text-main">Escolas</h3>
          <p class="text-xs text-text-muted mt-1">Eventos escolares e formaturas</p>
        </div>
        <div class="bg-white border border-bege-dark rounded-2xl p-6 text-center card-hover cursor-default">
          <div class="text-4xl mb-3">🏢</div>
          <h3 class="text-sm font-bold text-text-main">Corporativos</h3>
          <p class="text-xs text-text-muted mt-1">Dia das crianças no trabalho</p>
        </div>
        <div class="bg-white border border-bege-dark rounded-2xl p-6 text-center card-hover cursor-default">
          <div class="text-4xl mb-3">🏡</div>
          <h3 class="text-sm font-bold text-text-main">Condomínios</h3>
          <p class="text-xs text-text-muted mt-1">Festa para moradores</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-orange-dark">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center reveal">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6">Aluguel de {item.data.title} no Rio de Janeiro: Reserve Agora</h2>
        <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">Não perca tempo! Entre em contato agora e faça sua reserva de {item.data.title} no Rio de Janeiro. Atendemos toda a cidade do Rio de Janeiro e região metropolitana do RJ com entrega e montagem inclusas.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-orange-dark bg-bege rounded-xl hover:bg-white transition-all btn-press">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Reservar pelo WhatsApp
          </a>
          <a href={`tel:${SITE_CONFIG.nap.telephone}`} class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-transparent border-2 border-white/30 rounded-xl hover:bg-white/10 transition-all btn-press">Ligar Agora</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
