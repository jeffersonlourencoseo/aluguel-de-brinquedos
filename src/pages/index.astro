---
import Layout from '../layouts/Layout.astro';
import SchemaReviews from '../components/SchemaReviews.astro';
import { SITE_CONFIG } from '../data/config';
import { getCollection } from 'astro:content';
const brinquedos = await getCollection('brinquedos');
---

<Layout
  title="Aluguel de Brinquedos Rio de Janeiro | Brinquedos para Festa Infantil"
  description="Aluguel de brinquedos para festa infantil no Rio de Janeiro. Locação de cama elástica, pula pula aluguel, escorregador inflável, piscina de bolinhas e futebol de sabão aluguel. Entrega e montagem grátis RJ. Orçamento sem compromisso!"
>
  <Fragment slot="head">
    <SchemaReviews />
  </Fragment>

  <!-- HERO SECTION -->
  <section class="relative bg-bege overflow-hidden">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-5xl reveal">

        <!-- Badge / Tag -->
        <div class="inline-flex items-center gap-2 bg-bege-mid border border-bege-dark text-brown-mid font-bold text-xs px-3 py-1.5 rounded-full mb-8 max-w-[90vw] whitespace-nowrap">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Aluguel de Brinquedos no Rio de Janeiro
        </div>

        <!-- Título Principal -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-text-main leading-tight mb-10">
          Aluguel de Brinquedos para Festa Infantil no Rio de Janeiro
        </h1>

        <!-- Subtítulo persuasivo -->
        <p class="text-xl md:text-2xl text-text-muted leading-relaxed max-w-3xl mb-10">
          Aluguel de brinquedos para festa infantil no Rio de Janeiro: pula-pula, locação de cama elástica, aluguel de escorregador inflável, piscina de bolinhas e futebol de sabão aluguel. Somos referência em aluguel de brinquedos no Rio de Janeiro, com entrega rápida, preço justo e montagem grátis na cidade do Rio de Janeiro e região metropolitana do RJ.
        </p>

        <!-- Botões de Ação -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={SITE_CONFIG.social.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-orange rounded-xl hover:bg-orange-dark transition-all btn-press"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Solicitar Orçamento no WhatsApp
          </a>
          <a
            href="/brinquedos"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-orange-dark border-[1.5px] border-orange bg-transparent rounded-xl hover:bg-bege-mid transition-all"
          >
            Ver Nossos Equipamentos
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <!-- Stats de autoridade -->
        <div class="mt-12 sm:mt-16 border-t border-bege-dark pt-6 grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 container mx-auto px-6 lg:px-12">
          <div class="text-left">
            <div class="text-2xl font-extrabold text-orange-dark">+500</div>
            <div class="text-xs font-medium text-text-muted mt-1">Festas Animadas</div>
          </div>
          <div class="text-left">
            <div class="text-2xl font-extrabold text-orange-dark">+50</div>
            <div class="text-xs font-medium text-text-muted mt-1">Brinquedos Disponíveis</div>
          </div>
          <div class="text-left">
            <div class="text-2xl font-extrabold text-orange-dark">15+</div>
            <div class="text-xs font-medium text-text-muted mt-1">Anos no Mercado</div>
          </div>
          <div class="text-left">
            <div class="text-2xl font-extrabold text-orange-dark">100%</div>
            <div class="text-xs font-medium text-text-muted mt-1">Higienizados</div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- DIFERENCIAIS -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mb-16">
        <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Por que nos escolher</span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-main mb-6">Diferenciais do Nosso Aluguel de Brinquedos no Rio de Janeiro</h2>
        <p class="text-lg text-text-muted">Trabalhamos com seriedade e compromisso para garantir a diversão e segurança em cada evento.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 lg:gap-10 reveal stagger-children">
        <div class="bg-bege border border-bege-dark rounded-2xl p-4 text-center card-hover cursor-default">
          <div class="text-5xl mb-4">⚡</div>
          <h3 class="text-sm font-bold text-text-main mb-2">Entrega Rápida</h3>
          <p class="text-xs text-text-muted leading-relaxed">Chegamos no horário combinado e montamos tudo antes da festa começar. Pontualidade garantida.</p>
        </div>
        <div class="bg-bege border border-bege-dark rounded-2xl p-4 text-center card-hover cursor-default">
          <div class="text-5xl mb-4">🛡️</div>
          <h3 class="text-sm font-bold text-text-main mb-2">Equipamentos Revisados</h3>
          <p class="text-xs text-text-muted leading-relaxed">Todos os brinquedos passam por manutenção mensal e vistoria de segurança antes de cada evento.</p>
        </div>
        <div class="bg-bege border border-bege-dark rounded-2xl p-4 text-center card-hover cursor-default">
          <div class="text-5xl mb-4">💰</div>
          <h3 class="text-sm font-bold text-text-main mb-2">Melhor Preço</h3>
          <p class="text-xs text-text-muted leading-relaxed">Orçamento sem compromisso, sem taxas ocultas. Pacotes com desconto para 3 ou mais brinquedos.</p>
        </div>
        <div class="bg-bege border border-bege-dark rounded-2xl p-4 text-center card-hover cursor-default">
          <div class="text-5xl mb-4">🧼</div>
          <h3 class="text-sm font-bold text-text-main mb-2">Higienização Completa</h3>
          <p class="text-xs text-text-muted leading-relaxed">Limpeza profunda e desinfecção após cada uso. Segurança para as crianças é nossa prioridade.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- SOBRE NÓS RESUMO -->
  <section class="bg-bege-mid">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-16 items-center reveal">
        <div>
          <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Sobre Nós</span>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-main mb-6">Aluguel de Brinquedos no Rio de Janeiro com Mais de 15 Anos de Experiência</h2>
          <div class="space-y-4 text-text-muted text-lg leading-relaxed">
            <p>Fundada em 2009, a Aluguel de Brinquedos nasceu da paixão por ver crianças felizes e famílias reunidas em celebração no Rio de Janeiro. Começamos com apenas dois pula-pulas e hoje contamos com mais de 50 brinquedos infláveis para aluguel em toda a cidade do Rio de Janeiro e região metropolitana do RJ.</p>
            <p>Ao longo desses 15 anos, participamos de mais de 500 festas infantis, eventos corporativos e comemorações especiais em cidades como Niterói, São Gonçalo e Nova Iguaçu. Nosso compromisso é entregar diversão com total segurança.</p>
            <p>Nossa equipe é treinada para montar, supervisionar e garantir que cada brinquedo funcione perfeitamente durante todo o evento. Atendemos o Rio de Janeiro com entrega e montagem inclusas.</p>
          </div>
          <div class="mt-8">
            <a href="/sobre" class="inline-flex items-center text-lg font-semibold text-white bg-orange px-8 py-4 rounded-xl hover:bg-orange-dark transition-all btn-press">
              Conheça nossa História
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
        <div class="bg-white border border-bege-dark rounded-2xl p-6 lg:p-8 card-hover">
          <h3 class="text-2xl font-bold text-text-main mb-6">Nossos Números</h3>
          <div class="grid grid-cols-2 gap-6">
            <div>
              <div class="text-2xl font-extrabold text-orange-dark mb-1">+500</div>
              <div class="text-xs text-text-muted">Festas Realizadas</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-orange-dark mb-1">+50</div>
              <div class="text-xs text-text-muted">Brinquedos Disponíveis</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-orange-dark mb-1">15+</div>
              <div class="text-xs text-text-muted">Anos de Mercado</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-orange-dark mb-1">100%</div>
              <div class="text-xs text-text-muted">Clientes Satisfeitos</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- NOSSOS EQUIPAMENTOS -->
  <section id="brinquedos" class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mb-16">
        <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Catálogo</span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-main mb-6">Brinquedos para Aluguel no Rio de Janeiro</h2>
        <p class="text-lg text-text-muted">Brinquedos para aluguel no Rio de Janeiro com entrega e montagem grátis. Escolha pula-pula, escorregador inflável, cama elástica, piscina de bolinhas ou futebol de sabão e deixe sua festa infantil inesquecível na cidade do Rio de Janeiro e região metropolitana do RJ.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10 reveal stagger-children">
        {brinquedos.slice(0, 6).map((b) => (
          <div class="bg-white border border-bege-dark rounded-2xl p-6 card-hover hover:border-orange-light cursor-default">
            <div class="text-5xl mb-4">{b.data.icon}</div>
            <h3 class="text-sm font-bold text-orange-dark mb-2">{b.data.title}</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-4">{b.data.description}</p>
            <div class="flex justify-end">
              <a href={`/brinquedos/${b.slug}`} class="text-xs font-semibold text-orange-dark border border-orange bg-transparent rounded-md px-3 py-1 hover:bg-bege transition">Ver detalhes</a>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/brinquedos" class="inline-flex items-center justify-center px-6 py-3 text-lg font-semibold text-white bg-orange rounded-xl hover:bg-orange-dark transition-all btn-press">
          Ver Todos os Equipamentos
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>


  <!-- BLOG + CONTATO -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-16 items-stretch reveal stagger-children">

        <!-- BLOG -->
        <div>
          <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Blog</span>
          <h2 class="text-4xl md:text-5xl font-bold text-text-main mb-6">Dicas para sua Festa</h2>
          <p class="text-lg text-text-muted mb-8">Conteúdo exclusivo para ajudar você a organizar festas inesquecíveis.</p>

          <div class="space-y-6">
            <article class="bg-white border border-bege-dark rounded-2xl p-6 card-hover cursor-default">
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-block px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Dicas</span>
                <span class="text-xs text-text-muted">5 min</span>
              </div>
              <h3 class="text-sm font-bold text-text-main mb-2">Como Escolher o Brinquedo Ideal para a Idade da Criança</h3>
              <p class="text-xs text-text-muted mb-3">Descubra qual brinquedo inflável é mais adequado para cada faixa etária e como garantir diversão com segurança.</p>
              <a href="/blog/como-escolher-brinquedo" class="text-xs font-semibold text-orange hover:text-orange-dark transition-colors flex items-center gap-1">
                Ler mais
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </article>

            <article class="bg-white border border-bege-dark rounded-2xl p-6 card-hover cursor-default">
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-block px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Segurança</span>
                <span class="text-xs text-text-muted">4 min</span>
              </div>
              <h3 class="text-sm font-bold text-text-main mb-2">Segurança nos Brinquedos Infláveis: O que Verificar</h3>
              <p class="text-xs text-text-muted mb-3">Saiba quais cuidados são essenciais na hora de alugar brinquedos infláveis para garantir a segurança das crianças.</p>
              <a href="/blog/seguranca-brinquedos" class="text-xs font-semibold text-orange hover:text-orange-dark transition-colors flex items-center gap-1">
                Ler mais
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </article>
          </div>

          <div class="mt-8">
            <a href="/blog" class="inline-flex items-center text-lg font-semibold text-white bg-orange px-6 py-3 rounded-xl hover:bg-orange-dark transition-all btn-press">
              Ver todas as dicas
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>

        <!-- CONTATO / CTA -->
        <div class="bg-orange-dark rounded-2xl p-6 lg:p-8 text-white shadow-soft-lg flex flex-col justify-between">
          <div>
            <span class="inline-block text-xs font-bold text-orange-light uppercase tracking-widest mb-4">Contato</span>
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Solicitar Orçamento</h2>
            <p class="text-sm text-white/80 mb-6">
              Fale conosco agora e receba seu orçamento personalizado em até 30 minutos. Atendimento rápido via WhatsApp ou telefone.
            </p>

            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-orange-light" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </div>
                <div>
                  <h3 class="text-sm font-bold mb-0.5">WhatsApp</h3>
                  <p class="text-white/80 text-sm">{SITE_CONFIG.nap.whatsappDisplay}</p>
                  <p class="text-xs text-white/60 mt-0.5">Resposta em até 30 minutos</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-orange-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <h3 class="text-sm font-bold mb-0.5">Telefone</h3>
                  <p class="text-white/80 text-sm">{SITE_CONFIG.nap.phoneDisplay}</p>
                  <p class="text-xs text-white/60 mt-0.5">Segunda a Sexta, 8h às 20h</p>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6">
            <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-orange-dark bg-bege rounded-xl hover:bg-white transition-all btn-press">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Solicitar Orçamento Agora
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- DEPOIMENTOS -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mb-16">
        <span class="inline-block text-xs font-bold text-orange uppercase tracking-widest mb-4">Depoimentos</span>
