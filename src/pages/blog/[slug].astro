---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description}>

  <!-- HERO POST -->
  <section class="bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block px-4 py-1 text-sm font-bold text-secondary bg-primary rounded-full">{post.data.category}</span>
          <span class="text-sm text-gray-500">{post.data.date}</span>
          <span class="text-sm text-gray-500">{post.data.readTime} de leitura</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-secondary leading-tight mb-16">
          {post.data.title}
        </h1>
      </div>
    </div>
  </section>

  <!-- CONTEÚDO + SIDEBAR -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-3 gap-10">
        <!-- ARTIGO -->
        <div class="lg:col-span-2">
          <article class="prose prose-lg max-w-none prose-headings:text-secondary prose-a:text-secondary hover:prose-a:text-primary-600">
            <Content />
          </article>
        </div>

        <!-- SIDEBAR -->
        <div class="space-y-8">
          <!-- CTA Orçamento -->
          <div class="bg-secondary rounded-2xl p-8 text-white hover:shadow-lg hover:shadow-secondary/30 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-xl font-black mb-4">Quer alugar brinquedos?</h3>
            <p class="text-secondary-100 mb-6">Solicite seu orçamento gratuito agora e garanta a diversão do seu evento.</p>
            <a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full px-6 py-4 text-base font-bold text-secondary bg-primary rounded-xl hover:bg-primary-400 hover:scale-105 active:scale-95 transition-all shadow-lg shadow-primary/20">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Pedir Orçamento
            </a>
          </div>

          <!-- Posts Relacionados -->
          <div class="bg-gray-50 rounded-2xl p-8 hover:shadow-lg hover:shadow-primary/10 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-lg font-black text-secondary mb-4">Outras Dicas de Festas</h3>
            <div class="space-y-4">
              <a href="/blog/seguranca-brinquedos" class="block group">
                <div class="text-sm text-gray-500 mb-1">Segurança</div>
                <div class="font-bold text-secondary group-hover:text-primary transition-colors">Segurança nos Brinquedos Infláveis: O que Verificar</div>
              </a>
              <a href="/blog/como-escolher-brinquedo" class="block group">
                <div class="text-sm text-gray-500 mb-1">Dicas</div>
                <div class="font-bold text-secondary group-hover:text-primary transition-colors">Como Escolher o Brinquedo Ideal para a Idade da Criança</div>
              </a>
              <a href="/blog/dicas-festa-infantil" class="block group">
                <div class="text-sm text-gray-500 mb-1">Festas</div>
                <div class="font-bold text-secondary group-hover:text-primary transition-colors">5 Dicas para Organizar uma Festa Infantil Inesquecível</div>
              </a>
            </div>
          </div>

          <!-- Categorias -->
          <div class="bg-gray-50 rounded-2xl p-8 hover:shadow-lg hover:shadow-primary/10 hover:scale-[1.02] active:scale-95 transition-all cursor-default">
            <h3 class="text-lg font-black text-secondary mb-4">Categorias</h3>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 text-sm font-bold text-secondary bg-primary/20 rounded-full">Dicas</span>
              <span class="px-3 py-1 text-sm font-bold text-secondary bg-primary/20 rounded-full">Segurança</span>
              <span class="px-3 py-1 text-sm font-bold text-secondary bg-primary/20 rounded-full">Festas</span>
              <span class="px-3 py-1 text-sm font-bold text-secondary bg-primary/20 rounded-full">Economia</span>
              <span class="px-3 py-1 text-sm font-bold text-secondary bg-primary/20 rounded-full">Tendências</span>
              <span class="px-3 py-1 text-sm font-bold text-secondary bg-primary/20 rounded-full">Desenvolvimento</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
