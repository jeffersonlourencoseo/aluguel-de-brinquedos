---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';
import SchemaBlogPosting from '../../components/SchemaBlogPosting.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const pageUrl = `${SITE_CONFIG.url}/blog/${post.slug}`;
const postImage = post.data.image ? `${SITE_CONFIG.url}${post.data.image.replace(/^\.\.\/\.\.\//, '/')}` : `${SITE_CONFIG.url}/og-image.jpg`;
---

<Layout title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    <SchemaBlogPosting
      title={post.data.title}
      description={post.data.description}
      url={pageUrl}
      image={postImage}
      datePublished={post.data.date}
      category={post.data.category}
      readTime={post.data.readTime}
    />
  </Fragment>

  <!-- HERO POST -->
  <section class="bg-bege">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl">
        <Breadcrumb items={[
          { label: 'Início', url: '/' },
          { label: 'Blog', url: '/blog' },
          { label: post.data.title, url: pageUrl },
        ]} />
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">{post.data.category}</span>
          <span class="text-xs text-text-muted">{post.data.date}</span>
          <span class="text-xs text-text-muted">{post.data.readTime} de leitura</span>
        </div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-text-main leading-tight mb-8">
          {post.data.title}
        </h1>
      </div>
    </div>
  </section>

  <!-- CONTEÚDO + SIDEBAR -->
  <section class="bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10">
        <!-- ARTIGO -->
        <div class="lg:col-span-2">
          <article class="prose prose-lg max-w-none prose-headings:text-orange-dark prose-a:text-orange-dark hover:prose-a:text-orange">
            <Content />

            <!-- CTA INLINE NO MEIO DO ARTIGO -->
            <div class="not-prose my-10 bg-bege border-2 border-orange/20 rounded-2xl p-6 md:p-8">
              <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
                <div class="flex-1">
                  <h3 class="text-lg font-bold text-text-main mb-1">Quer Alugar Brinquedos para Festa?</h3>
                  <p class="text-sm text-text-muted">Solicite seu orçamento gratuito agora e garanta a diversão da criançada na cidade do Rio de Janeiro e região metropolitana do RJ.</p>
                </div>
                <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="shrink-0 inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-orange rounded-xl hover:bg-orange-dark transition-all">
                  <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Pedir Orçamento
                </a>
              </div>
            </div>
          </article>
        </div>

        <!-- SIDEBAR -->
        <div class="space-y-6">
          <!-- CTA Orçamento -->
          <div class="bg-orange-dark rounded-2xl p-6 text-white">
            <h3 class="text-xl font-bold mb-2">Quer alugar brinquedos?</h3>
            <p class="text-sm text-white/80 mb-4">Solicite seu orçamento gratuito agora e garanta a diversão do seu evento.</p>
            <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full px-4 py-3 text-sm font-semibold text-orange-dark bg-bege rounded-xl hover:bg-white transition-all">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Pedir Orçamento
            </a>
          </div>

          <!-- Posts Relacionados -->
          <div class="bg-white border border-bege-dark rounded-2xl p-6">
            <h3 class="text-sm font-bold text-text-main mb-4">Outras Dicas de Festas</h3>
            <div class="space-y-4">
              <a href="/blog/seguranca-brinquedos" class="block">
                <div class="text-xs text-text-muted mb-1">Segurança</div>
                <div class="text-xs font-bold text-orange-dark hover:text-orange transition-colors">Segurança nos Brinquedos Infláveis: O que Verificar</div>
              </a>
              <a href="/blog/como-escolher-brinquedo" class="block">
                <div class="text-xs text-text-muted mb-1">Dicas</div>
                <div class="text-xs font-bold text-orange-dark hover:text-orange transition-colors">Como Escolher o Brinquedo Ideal para a Idade da Criança</div>
              </a>
              <a href="/blog/dicas-festa-infantil" class="block">
                <div class="text-xs text-text-muted mb-1">Festas</div>
                <div class="text-xs font-bold text-orange-dark hover:text-orange transition-colors">5 Dicas para Organizar uma Festa Infantil Inesquecível</div>
              </a>
            </div>
          </div>

          <!-- Categorias -->
          <div class="bg-white border border-bege-dark rounded-2xl p-6">
            <h3 class="text-sm font-bold text-text-main mb-4">Categorias</h3>
            <div class="flex flex-wrap gap-2">
              <span class="px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Dicas</span>
              <span class="px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Segurança</span>
              <span class="px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Festas</span>
              <span class="px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Economia</span>
              <span class="px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Tendências</span>
              <span class="px-2 py-0.5 text-xs font-semibold text-brown-mid bg-bege-mid rounded-full">Desenvolvimento</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FLUTUANTE FIXO NO BOTTOM PARA MOBILE -->
  <div class="fixed bottom-0 left-0 right-0 z-50 lg:hidden">
    <a href={SITE_CONFIG.social.whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-full px-4 py-3.5 text-base font-semibold text-white bg-orange hover:bg-orange-dark transition-all shadow-lg">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Pedir Orçamento no WhatsApp
    </a>
  </div>

  <!-- ESPAÇO PARA O CTA FLUTUANTE NÃO TAPAR CONTEÚDO EM MOBILE -->
  <div class="h-14 lg:hidden"></div>

  <style is:global>
    @media (max-width: 1023px) {
      #whatsapp-float {
        display: none !important;
      }
    }
  </style>
</Layout>
